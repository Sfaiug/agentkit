# Browser bridge host: @HOST@
[Unit]
Description=Browser bridge Playwright MCP server, one process for every seat
Wants=browser-bridge-chromium.service network-online.target
After=browser-bridge-chromium.service network-online.target
PartOf=browser-bridge-xvfb.service
StartLimitIntervalSec=0

[Service]
User=@USER@
Environment="HOME=@HOME@"
Environment=DISPLAY=:99
Environment="XAUTHORITY=@TARGET@/Xauthority"
UMask=0077
ExecStart="@NODE@" "@TARGET@/mcp/node_modules/@playwright/mcp/cli.js" --cdp-endpoint http://127.0.0.1:9222 --host 127.0.0.1 --port 8931 --shared-browser-context
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
