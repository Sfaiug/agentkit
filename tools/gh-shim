#!/usr/bin/env python3
"""A `gh` first on a seat's PATH: refuse a seat's `gh pr merge` (merging is ak's job), else run the
real gh.  It gets the final argv bash built, so there is no shell string to parse.

The shim body is `agentkit.shim` (standard library only at import, the guard lazily, so a broken
guard still execs the real gh); this is the entry point PATH reaches.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from agentkit import shim

if __name__ == "__main__":
    sys.exit(shim.run("gh", "gh_refusal"))
