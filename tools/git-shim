#!/bin/sh
# A `git` first on a seat's PATH: refuse a seat's `git worktree add` into ~/code
# (agentkit/guard.py), else run the real git.  git is hot -- a seat and ak call it all the time --
# so only a call naming `worktree` starts Python; every other runs the real git at once.
# A seat's own call only: a worker (AK_RUN_ROLE=worker) and whatever runs seatless -- ak's own
# work, a test's sandbox -- pass, as the tmux and gh shims let them.
[ -n "$AGENTKIT_SESSION" ] && [ "$AK_RUN_ROLE" != worker ] && for arg do
    if [ "$arg" = worktree ]; then
        shim=$(readlink "$0") || shim=$0
        PYTHONPATH="${shim%/tools/*}" python3 -m agentkit.guard git "$@"
        [ $? = 3 ] && exit 1                    # guard.REFUSED; any other end runs git
        break
    fi
done
# The real git: the first on PATH after this shim's own, so a wrapper ahead of it that calls it
# chains on; with none after, the first that is not this shim.
set -f
IFS=:
past= first=
for dir in $PATH; do
    [ -n "$dir" ] && [ -x "$dir/git" ] || continue
    if [ "$dir/git" -ef "$0" ]; then
        past=1
    elif [ -n "$past" ]; then
        exec "$dir/git" "$@"
    else
        first=${first:-$dir/git}
    fi
done
[ -n "$first" ] && exec "$first" "$@"
echo "git-shim: no real git on PATH" >&2
exit 127
