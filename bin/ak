#!/usr/bin/env python3
"""agentkit entry point: `ak` is the menu; `ak <usage|worker|run|notify|wait|orch|attach|update|watch|browser> [args]`"""

import os
import signal
import sys
import threading
import time
from pathlib import Path

FOLDER = Path(__file__).resolve().parent.parent
# the version this process is of: a move swaps another folder in at this path at any moment, so
# it is read before any of the version's code loads (versions.final)
BEGAN = os.stat(FOLDER)
sys.path.insert(0, str(FOLDER))

from agentkit import command_help, config, owner  # noqa: E402

config.BEGAN = BEGAN

SUBS = ("usage", "models", "worker", "run", "notify", "wait", "orch", "attach", "update",
        "watch", "browser", "fetch", "macbridge", "doctor", "hand-in", "plan", "move")
# shown by no list or help: a check's own, lending its HOME this host's logins (agentkit/lend.py),
# a check's own proving each harness's adapter (agentkit/contract.py), and the way back from a
# move (agentkit/back.py), listed once Go, printing the same list, has it
UNLISTED = ("lend", "contract", "back")
# `ak attach` is the menu under the name the phone key uses; a bare `ak` is the menu too, and
# `ak doctor` is the tick's own check-up, which is where the tick lives, and so is `ak wait`,
# beside the ladder that reads it
ENTRY = {"attach": ("menu", "main"), "fetch": ("macbridge", "fetch_main"),
         "doctor": ("watch", "doctor"), "wait": ("watch", "wait_main"),
         "hand-in": ("hand_in", "main"), "models": ("matrix", "main")}
INTERRUPT_GRACE = 1     # seconds Ctrl-C leaves stdout and stderr to take what ak still holds


def _finish(name, write):
    """`write` to the standard stream called `name`.  One that refuses leaves `sys`, as the
    interpreter's flush at exit would only be refused again and turn the exit into 120."""
    stream = getattr(sys, name)
    try:
        if stream:
            write(stream)
    except (OSError, ValueError):
        setattr(sys, name, None)


def interrupted(sub):
    """Ctrl-C's exit status, reached within INTERRUPT_GRACE whatever stdout and stderr are.  The
    writes stay the ordinary blocking ones, so no other holder of either stream sees a thing, on
    a thread each so neither waits on the other; one still blocked ends with the process, since
    the interpreter's flush at exit would block for good."""
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    writes = [threading.Thread(target=_finish, args=args, daemon=True) for args in (
        ("stdout", lambda out: out.flush()),
        ("stderr", lambda err: print(f"\nak {sub}: interrupted", file=err)))]
    deadline = time.monotonic() + INTERRUPT_GRACE
    for write in writes:
        write.start()
    for write in writes:
        write.join(deadline - time.monotonic())
    if any(write.is_alive() for write in writes):
        os._exit(130)
    return 130


def main():
    argv = sys.argv[1:]
    if not argv or argv[0].startswith("-"):
        sub, rest = "attach", argv        # `ak`, `ak --client`, `ak --overlay`, `ak --dry-run`
    else:
        sub, rest = argv[0], argv[1:]
    try:
        config.migrate_policy()
        if sub not in SUBS + UNLISTED:
            print(f"ak: unknown subcommand {sub!r}; expected one of {', '.join(SUBS)}", file=sys.stderr)
            return 2
        if sub in SUBS and command_help.show(sub if argv and argv[0] == sub else "", rest):
            return 0
        if sub in ("run", "hand-in"):
            from agentkit import versions
            versions.dispatch(argv)
        mod_name, entry = ENTRY.get(sub, (sub, "main"))
        module = __import__(f"agentkit.{mod_name}", fromlist=[entry])
        owner.mark(f"ak {sub}")
        if sub == "run" and rest[:1] == ["gc"]:
            from agentkit import gc
            return gc.cmd_gc(rest[1:])
        return getattr(module, entry)(rest)
    except config.Error as exc:
        print(f"ak {sub}: {exc}", file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        return interrupted(sub)


if __name__ == "__main__":
    sys.exit(main())
